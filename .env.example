# --- Appointment request form (/book -> POST /api/inquiry) ---
# These are read by the Netlify Function in netlify/functions/inquiry.mts.
# In production, set them in Netlify: Site settings > Environment variables.
# Locally, put them in .env and run `netlify dev` (astro dev alone does not
# serve functions).

# Resend API key. Create at https://resend.com/api-keys
RESEND_API_KEY=

# Where requests are delivered. Comma-separate for multiple recipients.
INQUIRY_TO_EMAIL=intake@harmonyfortworth.com

# Sender address. Must be on a domain verified in Resend.
INQUIRY_FROM_EMAIL=website@harmonyfortworth.com

# Absolute origin used for the logo and links in outgoing emails.
PUBLIC_SITE_URL=https://harmonyfortworth.com
