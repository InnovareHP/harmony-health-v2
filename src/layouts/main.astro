---
import MainLayout from "../components/layout/MainLayout";
import { DEFAULT_META, PAGE_META } from "../lib/seo";
import '../styles/global.css';

const { pathname } = Astro.url;
const isIndexPage = pathname === "/";

const routeKey = pathname.replace(/\/(index\.html)?$/, "");
const { title, description } = PAGE_META[routeKey] ?? DEFAULT_META;
// Live URLs end with a trailing slash; canonicals must match.
const canonical = new URL(`${routeKey}/`, Astro.site).href;
const ogImage = new URL("/images/our-focus.png", Astro.site).href;

// Must match the visible footer/contact details. No ratings or reviews.
const orgId = "https://harmonyfortworth.com/#organization";
const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": ["Hospital", "MedicalOrganization"],
      "@id": orgId,
      name: "Harmony Health",
      url: "https://harmonyfortworth.com/",
      logo: "https://harmonyfortworth.com/images/harmony-health-logo.png",
      image: ogImage,
      telephone: "+1-817-529-3170",
      faxNumber: "+1-817-529-3171",
      address: {
        "@type": "PostalAddress",
        streetAddress: "7001 Bryant Irvin Rd",
        addressLocality: "Fort Worth",
        addressRegion: "TX",
        postalCode: "76132",
        addressCountry: "US",
      },
      contactPoint: [
        {
          "@type": "ContactPoint",
          telephone: "+1-844-570-7444",
          contactType: "24/7 Intake Assessment Hotline",
          areaServed: "US",
          availableLanguage: "English",
        },
        {
          "@type": "ContactPoint",
          telephone: "+1-844-570-6444",
          contactType: "Main Toll Free",
          areaServed: "US",
        },
      ],
      sameAs: [
        "https://www.instagram.com/harmonyhealthfw",
        "https://www.facebook.com/share/1CXjCUa5Br/",
        "https://www.linkedin.com/company/harmonyfortworth/",
      ],
    },
    {
      "@type": "WebPage",
      "@id": `${canonical}#webpage`,
      url: canonical,
      name: title,
      description,
      about: { "@id": orgId },
      isPartOf: {
        "@type": "WebSite",
        "@id": "https://harmonyfortworth.com/#website",
        url: "https://harmonyfortworth.com/",
        name: "Harmony Health",
        publisher: { "@id": orgId },
      },
    },
  ],
};
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <!-- Google tag (gtag.js) -->
    <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-5Z6NL2RG62"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());

      // Skip localhost, netlify dev and deploy previews so reports stay clean.
      if (location.hostname === 'harmonyfortworth.com' || location.hostname === 'www.harmonyfortworth.com') {
        gtag('config', 'G-5Z6NL2RG62');

        // Phone number only; never send form contents or program interest.
        document.addEventListener('click', function (e) {
          var link = e.target.closest && e.target.closest('a[href^="tel:"]');
          if (link) gtag('event', 'phone_call_click', { link_url: link.getAttribute('href') });
        });
      }
    </script>

    <!-- Title & Description -->
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <!-- Open Graph for Social Sharing -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Harmony Health" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <!-- Author and Generator -->
    <meta name="author" content="Harmony Health" />
    <meta name="generator" content="Astro" />
  </head>

  <body>
     <MainLayout client:load isIndexPage={isIndexPage}>
      <slot />
    </MainLayout>
  </body>
</html>
